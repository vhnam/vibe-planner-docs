@startuml BackOffice
left to right direction
skinparam packageStyle rectangle

actor "System Curator / Moderator" as Curator
actor "Data Integrator / Engineer" as Integrator
actor "Recommendation Designer" as RecoDesigner
actor "Community Manager / Admin" as CommunityAdmin
actor "Product Analyst" as Analyst
actor "Super Admin" as SuperAdmin

package "Back Office System" {
  (Moderate User Content) as BUC01
  (Merge Duplicate Spots) as BUC02
  (Validate External Data) as BUC03
  (Run ETL Sync) as BUC04
  (Configure Recommendation Model) as BUC05
  (Run A/B Test) as BUC06
  (Handle Reports & Violations) as BUC07
  (View Analytics Dashboard) as BUC08
  (Manage Access & Roles) as BUC09
}

Curator --> BUC01
Curator --> BUC02
Integrator --> BUC03
Integrator --> BUC04
RecoDesigner --> BUC05
RecoDesigner --> BUC06
CommunityAdmin --> BUC07
Analyst --> BUC08
SuperAdmin --> BUC09

BUC03 .> BUC04 : <<include>>
BUC05 .> BUC06 : <<extend>>
BUC01 .> BUC02 : <<include>>
@enduml
