@startuml FrontlineU
left to right direction
skinparam packageStyle rectangle

actor Traveler
actor "Group Planner" as GP
actor "Spot Curator" as SC
actor "Local Contributor" as LC
actor "Creator" as CR
actor "Collaborator / Viewer" as CV
actor Guest

package "Frontline App" {
  (Create Trip) as UC01
  (Edit Trip) as UC02
  (Invite Collaborator) as UC03
  (Add Spot to Trip) as UC04
  (Save Favorite Spot) as UC05
  (Submit Review) as UC06
  (Record Route) as UC07
  (Publish Trip Story) as UC08
  (View Shared Trip) as UC09
  (Comment / React) as UC10
  (Clone Trip / Reuse Template) as UC11
  (Receive Recommendation) as UC12
  (View Memories & Rewards) as UC13
}

Traveler --> UC01
Traveler --> UC02
Traveler --> UC04
Traveler --> UC05
Traveler --> UC06
Traveler --> UC11
Traveler --> UC12
Traveler --> UC13

GP --> UC01
GP --> UC02
GP --> UC03
GP --> UC04
GP --> UC12

SC --> UC05
SC --> UC06

LC --> UC07
LC --> UC04
LC --> UC08

CR --> UC08
CR --> UC13
CR --> UC10

CV --> UC09
CV --> UC10
Guest --> UC09

UC06 .> UC05 : <<include>>
UC08 .> UC07 : <<include>>
UC09 .> UC10 : <<extend>>
@enduml
